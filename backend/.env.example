# Copy this file to ".env" and adjust the values.
# .env is listed in .gitignore — NEVER commit real credentials.

# Port the Express server listens on
PORT=5000

# PostgreSQL connection string.
# Replace USER, PASSWORD and database name with your own values.
# The demo below matches the embedded dev database (npm run db:start).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/classsync

# Secret used to sign login session tokens (Stage 6).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

